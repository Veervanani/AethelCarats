generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("CUSTOMER")
  avatar       String?
  employeeId   String?       @unique
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  object    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  description        String?
  bannerImage        String?
  image              String?
  link               String?
  sortOrder          Int       @default(0)
  isActive           Boolean   @default(true)
  enableRingSize     Boolean   @default(true)
  enableMetal        Boolean   @default(true)
  enableDiamond      Boolean   @default(true)
  enableDiamondShape Boolean   @default(true)
  enableDiamondCert  Boolean   @default(true)
  enableEngraving    Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  products           Product[]
}

model Collection {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  bannerImage    String?
  thumbnailImage String?
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model Product {
  id                     String                  @id @default(uuid())
  name                   String
  sku                    String                  @unique
  slug                   String                  @unique
  categoryId             String?
  collectionId           String?
  shortDescription       String?
  fullDescription        String?
  specifications         String?
  careInstructions       String?
  jewelleryType          String?
  ringStyle              String?
  ringSize               String?
  ringWidth              String?
  gender                 String?                 @default("Unisex")
  metal                  String?
  metalColor             String?
  goldPurity             String?
  goldColor              String?
  goldWeight             Float?
  diamondType            String?
  shape                  String?
  carat                  Float?
  color                  String?
  colorType              String?
  fancyColor             String?
  fancyIntensity         String?
  fancyModifier          String?
  clarity                String?
  cut                    String?
  polish                 String?
  symmetry               String?
  fluorescence           String?
  certificateNo          String?
  certification          String?
  gemstone               String?
  gemstoneColor          String?
  pearlType              String?
  birthstone             String?
  plainMetal             Boolean                 @default(false)
  onSale                 Boolean                 @default(false)
  engravable             Boolean                 @default(false)
  metaTitle              String?
  metaDescription        String?
  metaKeywords           String?
  price                  Float
  comparePrice           Float?
  salePrice              Float?
  currency               String                  @default("USD")
  stockQuantity          Int                     @default(10)
  status                 String                  @default("ACTIVE")
  mainImage              String
  secondaryImage         String?
  isFeatured             Boolean                 @default(false)
  isNewArrival           Boolean                 @default(true)
  isBestseller           Boolean                 @default(false)
  isSettingOnly          Boolean                 @default(false)
  pricingMode            String                  @default("BASE")
  enableMetalSelection   Boolean                 @default(true)
  enableDiamondSelection Boolean                 @default(true)
  enableDiamondShape     Boolean                 @default(true)
  enableCustomOptions    Boolean                 @default(false)
  variationsJson         String?
  customOptionsJson      String?
  shippingInfoJson       String?
  enableRingSize         Boolean                 @default(false)
  ringSizeMode           String                  @default("CUSTOMER_SELECTABLE")
  fixedRingSize          String?                 @default("7")
  availableRingSizes     String?
  isRingSizeRequired     Boolean                 @default(true)
  metalsConfig           String?
  diamondsConfig         String?
  benefitsConfig         String?
  accordionsConfig       String?
  pricingMatrix          String?
  draftData              String?
  ogImage                String?
  schemaInformation      String?
  title                  String?
  masterPrice14k         Float?
  masterPrice18k         Float?
  masterPriceSilver      Float?
  diamondDetailsJson     String?
  internalTagsJson       String?
  seoSocialJson          String?
  processingTimeDays     Int?                    @default(3)
  craftsmanshipHeading   String?
  craftsmanshipStory     String?
  editorialImage         String?
  recommendedProductIds  String?
  completeLookProductIds String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  cartItems              CartItem[]
  customerSpecificPrices CustomerSpecificPrice[]
  orderItems             OrderItem[]
  category               Category?               @relation(fields: [categoryId], references: [id])
  collection             Collection?             @relation(fields: [collectionId], references: [id])
  images                 ProductImage[]
  variants               ProductVariant[]
  videos                 ProductVideo[]
  reviews                Review[]
  wishlistItems          WishlistItem[]
  detailSections         ProductDetailSection[]
  pageContent            ProductPageContent?
  internalSales          InternalSale[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String   @unique
  metal     String?
  goldColor String?
  size      String?
  price     Float
  stock     Int      @default(5)
  weight    Float?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  title     String?
  imageType String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String   @id @default(uuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  author     String
  email      String?
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Diamond {
  id                String   @id @default(uuid())
  diamondId         String   @unique
  stockId           String?
  sku               String?
  diamondType       String   @default("NATURAL")
  growthType        String?  // e.g. HPHT, CVD
  shape             String
  carat             Float
  color             String
  clarity           String
  cut               String?
  polish            String?
  symmetry          String?
  fluorescence      String?
  length            Float?
  width             Float?
  depth             Float?
  ratio             Float?   // Length-to-Width Ratio
  tablePercent      Float?
  depthPercent      Float?
  crownAngle        Float?
  pavilionAngle     Float?
  girdle            String?
  culet             String?
  lab               String?
  certificateNumber String?
  certificateUrl    String?
  price             Float
  pricePerCarat     Float?   // P/CT
  currency          String   @default("USD")
  status            String   @default("AVAILABLE")
  fancyColor        String?
  fancyOvertone     String?
  fancyIntensity    String?
  imageUrl          String?
  videoUrl          String?
  video360Url       String?
  certificatePdfUrl String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  internalSales     InternalSale[]

  @@index([shape, diamondType, carat, price, status])
}

model DiamondImportHistory {
  id            String   @id @default(uuid())
  fileName      String
  totalRows     Int
  importedCount Int
  updatedCount  Int
  failedCount   Int
  errorReport   String?
  importedBy    String   @default("Admin")
  createdAt     DateTime @default(now())
}

model CustomRequest {
  id                String               @id @default(uuid())
  requestNumber     String               @unique
  name              String
  email             String
  whatsapp          String
  jewelleryType     String
  metal             String?
  diamondPreference String?
  budget            String?
  deadline          String?
  description       String
  status            String               @default("NEW")
  cadFileUrl        String?
  adminNotes        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  files             CustomRequestFile[]
  timelines         CustomTimelineItem[]
}

model CustomRequestFile {
  id              String        @id @default(uuid())
  customRequestId String
  fileUrl         String
  fileType        String
  createdAt       DateTime      @default(now())
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
}

model CustomTimelineItem {
  id              String        @id @default(uuid())
  customRequestId String
  status          String
  note            String?
  createdAt       DateTime      @default(now())
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
}

model Customer {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String
  phone              String?
  country            String?
  company            String?
  address            String?
  assignedEmployeeId String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  addresses          Address[]
  carts              Cart[]
  customerPrices     CustomerSpecificPrice[]
  orders             Order[]
  wishlists          Wishlist[]
  internalSales      InternalSale[]
  assignedEmployee   Employee?               @relation("AssignedCustomerEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
}

model CustomerSpecificPrice {
  id                       String   @id @default(uuid())
  customerId               String
  productId                String
  specialPrice             Float?
  priceAdjustment          Float?   @default(0)
  metalsPriceAdjustments   String?
  diamondsPriceAdjustments String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model RingSizeGuide {
  id                 String   @id @default("main")
  title              String   @default("Ring Size Guide")
  slug               String   @default("find-your-ring-size")
  status             String   @default("PUBLISHED")
  heroTitle          String?  @default("FIND YOUR PERFECT RING SIZE")
  heroSubtitle       String?  @default("Comprehensive Floksy Jewel Sizing Guide")
  heroImage          String?
  heroImagePosition  String?  @default("center")
  heroBg             String?  @default("#19202A")
  heroCtaText        String?  @default("Request Free Ring Sizer")
  heroCtaUrl         String?  @default("#free-sizer")
  introHeading       String?  @default("Precision Sizing for Life's Timeless Moments")
  introParagraphs    String?
  introContent       String?
  infoHeading        String?  @default("International Ring Size Conversion")
  infoDescription    String?  @default("Measure your finger diameter or convert existing ring sizes using our standardized international chart.")
  chartImage         String?
  chartTitle         String?  @default("Ring Size Measurement Chart")
  chartDescription   String?  @default("Print at 100% scale to match your existing rings directly.")
  conversionsJson    String?
  sizerHeading       String?  @default("COMPLIMENTARY FLOKSY RING SIZER")
  sizerDescription   String?  @default("Receive our reusable precision ring sizer delivered directly to your door.")
  sizerImage         String?
  sizerButtonText    String?  @default("REQUEST FREE SIZER")
  sizerButtonUrl     String?  @default("#request-sizer")
  measureHeading     String?  @default("HOW TO MEASURE AT HOME")
  measureDescription String?  @default("Follow these three simple steps using a strip of paper or string.")
  measureStepsJson   String?
  ctaHeading         String?  @default("NEED EXPERT SIZING ASSISTANCE?")
  ctaDescription     String?  @default("Our master jewellers are available 7 days a week.")
  ctaButtonText      String?  @default("BOOK ATELIER CONSULTATION")
  ctaButtonUrl       String?  @default("/contact-us")
  ctaBg              String?  @default("#19202A")
  seoTitle           String?  @default("Ring Size Guide | Floksy Jewel")
  metaDescription    String?  @default("Find your perfect ring size with Floksy Jewel's comprehensive international ring size conversion chart and complimentary sizer.")
  keywords           String?  @default("ring size guide, ring sizer, international ring sizes, measure ring size")
  canonicalUrl       String?  @default("https://floksyjewel.com/education/rings/find-your-ring-size")
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  type       String   @default("SHIPPING")
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  orderDate       DateTime         @default(now())
  customerId      String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  billingAddress  String?
  shippingAddress String?
  subtotal        Float            @default(0)
  tax             Float            @default(0)
  shippingFee     Float            @default(0)
  discount        Float            @default(0)
  totalAmount     Float            @default(0)
  currency        String           @default("USD")
  orderStatus     String           @default("CONFIRMED")
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invoices        Invoice[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  receipts        PaymentReceipt[]
  refunds         Refund[]
  shipments       Shipment[]
  statements      Statement[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  diamondId   String?
  productName String
  sku         String?
  variantInfo String?
  unitPrice   Float    @default(0)
  quantity    Int      @default(1)
  discount    Float    @default(0)
  tax         Float    @default(0)
  subtotal    Float    @default(0)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id            String           @id @default(uuid())
  paymentNumber String?          @unique
  orderId       String
  paymentDate   DateTime         @default(now())
  amount        Float
  currency      String           @default("USD")
  paymentMethod String           @default("Bank Transfer")
  provider      String?          @default("MANUAL")
  transactionId String?
  referenceId   String?
  status        String           @default("SUCCESS")
  notes         String?
  recordedBy    String?          @default("Admin")
  proofUrl      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receipts      PaymentReceipt[]
  refunds       Refund[]
}

model Refund {
  id           String   @id @default(uuid())
  refundNumber String   @unique
  orderId      String
  paymentId    String?
  refundDate   DateTime @default(now())
  amount       Float
  refundMethod String   @default("Original Payment Method")
  referenceId  String?
  reason       String?
  notes        String?
  recordedBy   String?  @default("Admin")
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment      Payment? @relation(fields: [paymentId], references: [id])
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  paymentId     String
  orderId       String
  amount        Float
  currency      String   @default("USD")
  issuedAt      DateTime @default(now())
  pdfUrl        String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  orderId       String
  issuedAt      DateTime @default(now())
  pdfUrl        String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Statement {
  id              String    @id @default(uuid())
  statementNumber String    @unique
  title           String
  type            String
  customerId      String?
  orderId         String?
  fromDate        DateTime?
  toDate          DateTime?
  month           Int?
  year            Int?
  pdfUrl          String?
  generatedBy     String    @default("Admin")
  createdAt       DateTime  @default(now())
  order           Order?    @relation(fields: [orderId], references: [id])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialAuditLog {
  id         String   @id @default(uuid())
  adminUser  String   @default("Admin")
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  carrier        String
  trackingNumber String
  status         String    @default("SHIPPED")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id         String         @id @default(uuid())
  customerId String?
  sessionId  String?
  createdAt  DateTime       @default(now())
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String?
  diamondId  String?
  createdAt  DateTime @default(now())
  product    Product? @relation(fields: [productId], references: [id])
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
}

model Cart {
  id         String     @id @default(uuid())
  customerId String?
  sessionId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String?
  diamondId String?
  quantity  Int      @default(1)
  metal     String?
  goldColor String?
  size      String?
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model Page {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  content         String?
  draftContent    String?
  status          String         @default("PUBLISHED")
  lastPublishedAt DateTime?
  publishedBy     String?
  lastModifiedBy  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  faqs            FaqItem[]
  revisions       PageRevision[]
  sections        PageSection[]
  seoMetadata     SeoMetadata?
}

model PageSection {
  id        String  @id @default(uuid())
  pageId    String
  blockType String
  position  Int     @default(0)
  content   String
  isVisible Boolean @default(true)
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  version   Int
  action    String   @default("UPDATE")
  adminUser String   @default("Admin")
  content   String
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model FaqItem {
  id          String   @id @default(uuid())
  pageId      String?
  question    String
  answer      String
  category    String   @default("General")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  author          String   @default("Floksy Concierge")
  publishDate     DateTime @default(now())
  featuredImage   String?
  excerpt         String?
  content         String
  seoTitle        String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?
  ogImage         String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Menu {
  id        String     @id @default(uuid())
  name      String
  location  String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id        String     @id @default(uuid())
  menuId    String
  title     String
  url       String
  position  Int        @default(0)
  parentId  String?
  megaMenu  String?
  isVisible Boolean    @default(true)
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuHierarchy")
}

model FilterGroup {
  id            String         @id @default(uuid())
  key           String
  label         String
  categoryScope String         @default("ALL")
  targetType    String         @default("JEWELLERY")
  filterType    String         @default("MULTISELECT")
  sortOrder     Int            @default(0)
  isEnabled     Boolean        @default(true)
  isSystem      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  options       FilterOption[]

  @@unique([key, categoryScope])
}

model FilterOption {
  id            String      @id @default(uuid())
  filterGroupId String
  label         String
  value         String
  icon          String?
  iconUrl       String?
  colorHex      String?
  sortOrder     Int         @default(0)
  isEnabled     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  filterGroup   FilterGroup @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)
}

model Promotion {
  id              String    @id @default(uuid())
  title           String
  type            String    @default("PROMO_BANNER")
  heading         String?
  subheading      String?
  description     String?
  imageUrl        String?
  mobileImageUrl  String?
  videoUrl        String?
  buttonText      String?
  buttonUrl       String?
  linkUrl         String?
  backgroundColor String?
  textColor       String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SeoMetadata {
  id                 String   @id @default(uuid())
  pageId             String?  @unique
  entityType         String?
  entityId           String?
  seoTitle           String
  metaDescription    String
  canonicalUrl       String?
  robots             String   @default("index, follow")
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterCard        String?  @default("summary_large_image")
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  updatedAt          DateTime @updatedAt
  page               Page?    @relation(fields: [pageId], references: [id])
}

model Redirect {
  id         String   @id @default(uuid())
  oldUrl     String   @unique
  newUrl     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model Media {
  id         String   @id @default(uuid())
  name       String
  url        String
  fileType   String
  fileSize   Int
  altText    String?
  dimensions String?
  createdAt  DateTime @default(now())
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE")
  discountValue  Float
  minOrderAmount Float?
  startDate      DateTime?
  endDate        DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  country   String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model DiamondFilterConfig {
  id         String                @id @default(uuid())
  key        String                @unique
  title      String
  filterType String                @default("MULTISELECT")
  sortOrder  Int                   @default(0)
  isEnabled  Boolean               @default(true)
  configJson String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  options    DiamondFilterOption[]
}

model DiamondFilterOption {
  id        String              @id @default(uuid())
  configId  String
  label     String
  value     String
  iconUrl   String?
  colorHex  String?
  sortOrder Int                 @default(0)
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  config    DiamondFilterConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}

model MegaMenuCard {
  id             String   @id @default(uuid())
  categorySlug   String
  title          String
  subtitle       String?
  description    String?
  imageUrl       String
  mobileImageUrl String?
  targetUrl      String
  altText        String?
  isEnabled      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageReview {
  id            String   @id @default(uuid())
  customerName  String
  rating        Int      @default(5)
  reviewText    String
  customerImage String?
  location      String?
  reviewDate    String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductFilterConfig {
  id                       String                @id @default(uuid())
  key                      String                @unique
  name                     String
  customerLabel            String
  filterType               String                @default("Multi Select")
  sortOrder                Int                   @default(0)
  isEnabled                Boolean               @default(true)
  applicableJewelleryTypes String                @default("All")
  configJson               String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  options                  ProductFilterOption[]
}

model ProductFilterOption {
  id                       String              @id @default(uuid())
  filterId                 String
  label                    String
  value                    String
  iconUrl                  String?
  colorHex                 String?
  sortOrder                Int                 @default(0)
  isEnabled                Boolean             @default(true)
  applicableJewelleryTypes String              @default("All")
  metadataJson             String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  filter                   ProductFilterConfig @relation(fields: [filterId], references: [id], onDelete: Cascade)
}

model ProductDetailSection {
  id           String              @id @default(uuid())
  productId    String
  title        String
  type         String              @default("CUSTOM")
  description  String?
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items        ProductDetailItem[]
}

model ProductDetailItem {
  id           String               @id @default(uuid())
  sectionId    String
  title        String?
  description  String?
  value        String?
  imageUrl     String?
  icon         String?
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  section      ProductDetailSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model ProductPageContent {
  id                        String   @id @default(uuid())
  productId                 String?  @unique
  heroTitle                 String?
  heroSubtitle              String?
  heroShortDescription      String?
  heroAnnouncement          String?
  heroBreadcrumbLabel       String?
  benefitsJson              String?
  accordionsJson            String?
  shippingInfoJson          String?
  craftsmanshipTitle        String?
  craftsmanshipDescription  String?
  sustainabilityInfo        String?
  manufacturingInfo         String?
  materialsInfo             String?
  certificationInfo         String?
  craftsmanshipImage        String?
  packagingHeading          String?
  packagingDescription      String?
  packagingItemsJson        String?
  packagingImageUrl         String?
  reviewsTitle              String?
  reviewsEnabled            Boolean  @default(true)
  reviewsVerifiedBadge      Boolean  @default(true)
  reviewsSubmissionEnabled  Boolean  @default(true)
  reviewsDefaultSort        String?  @default("newest")
  similarItemsTitle         String?
  similarProductsJson       String?
  similarItemsEnabled       Boolean  @default(true)
  recentlyViewedTitle       String?
  recentlyViewedEnabled     Boolean  @default(true)
  showBenefits              Boolean  @default(true)
  showExperienceAccordion   Boolean  @default(true)
  showSpecifications        Boolean  @default(true)
  showCraftsmanshipSection  Boolean  @default(true)
  showPackagingSection      Boolean  @default(true)
  showReviews               Boolean  @default(true)
  showSimilarItems          Boolean  @default(true)
  showRecentlyViewed        Boolean  @default(true)
  showBuyNowButton          Boolean  @default(true)
  showStickyBar             Boolean  @default(true)
  showQuantitySelector      Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  product                   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model HeroBanner {
  id               String   @id @default(uuid())
  title            String
  subtitle         String?
  description      String?
  primaryCtaText   String?
  primaryCtaLink   String?
  secondaryCtaText String?
  secondaryCtaLink String?
  productType      String   @default("Engagement Ring")
  imagePath        String
  mobileImagePath  String?
  imageAlt         String?
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Supplier {
  id            String         @id @default(uuid())
  name          String         @unique
  contactPerson String?
  email         String?
  phone         String?
  country       String?
  notes         String?
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         InternalSale[]
}

model Employee {
  id                 String           @id @default(uuid())
  employeeCode       String           @unique
  userId             String?          @unique
  user               User?
  fullName           String
  email              String           @unique
  phone              String?
  department         String?          @default("Sales")
  designation        String?          @default("Sales Executive")
  role               String           @default("SALES_EMPLOYEE")
  status             String           @default("ACTIVE")
  joiningDate        DateTime?
  commissionPlanId   String?
  monthlySalesTarget Float?           @default(0)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  attendances        Attendance[]
  sales              InternalSale[]
  commissions        Commission[]
  salesTargets       SalesTarget[]
  commissionRules    CommissionRule[]
  assignedCustomers  Customer[]       @relation("AssignedCustomerEmployee")
  commissionPlan     CommissionPlan?  @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)
}

model Attendance {
  id               String    @id @default(uuid())
  employeeId       String
  date             DateTime
  checkInTime      DateTime?
  checkOutTime     DateTime?
  workingHours     Float?    @default(0)
  status           String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE, HOLIDAY
  lateStatus       Boolean   @default(false)
  notes            String?
  isManualEntry    Boolean   @default(false)
  modifiedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date, status])
}

model CommissionPlan {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isDefault   Boolean          @default(false)
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rules       CommissionRule[]
  employees   Employee[]
}

model CommissionRule {
  id              String          @id @default(uuid())
  planId          String?
  employeeId      String?
  productType     String?         @default("ALL") // ALL, DIAMOND, JEWELRY
  commissionBasis String          @default("NET_PROFIT") // NET_PROFIT, SALE_AMOUNT, FIXED_AMOUNT
  commissionRate  Float           @default(0) // e.g. 0.05 for 5%
  minAmount       Float?
  maxAmount       Float?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  status          String          @default("ACTIVE")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  plan            CommissionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee        Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model InternalSale {
  id                    String        @id @default(uuid())
  invoiceNo             String        @unique
  saleDate              DateTime      @default(now())
  customerId            String?
  customerName          String
  customerCountry       String?
  productType           String        @default("Diamond") // Diamond, Jewelry
  productDescription    String?
  stoneType             String?       // Natural, CVD
  shape                 String?
  diamondColor          String?
  clarity               String?
  cut                   String?
  polish                String?
  symmetry              String?
  fluorescence          String?
  measurement           String?
  pricePerCarat         Float?
  caratWeight           Float?
  quantity              Float?        @default(1)
  certificate           String?
  certificateNo         String?
  supplierId            String?
  supplierName          String?
  purchasePrice         Float         @default(0)
  sellingPrice          Float         @default(0)
  discount              Float         @default(0)
  finalSaleAmount       Float         @default(0)
  shippingCost          Float         @default(0)
  gstPercent            Float         @default(0) // e.g. 0.015 for 1.5%
  gstAmount             Float         @default(0)
  finalPurchasePrice    Float         @default(0)
  paymentStatus         String        @default("Paid") // Paid, Partial, Pending, Unpaid
  paymentMethod         String?       @default("Bank Wire") // Bank Wire, Bank, Cash, PayPal
  amountReceived        Float         @default(0)
  pendingAmount         Float         @default(0)
  grossProfit           Float         @default(0)
  netProfit             Float         @default(0)
  employeeId            String?
  salesPersonName       String?
  commissionPercent     Float         @default(0)
  commissionAmount      Float         @default(0)
  profitAfterCommission Float         @default(0)
  markupPercent         Float         @default(0)
  finalProfitPercent    Float         @default(0)
  orderStatus           String        @default("Delivered") // Delivered, Shipped, Processing, Cancelled
  trackingNumber        String?
  trackingLink          String?
  dollarRate            Float?
  saleMonth             String?
  notes                 String?
  isImported            Boolean       @default(false)
  diamondId             String?
  productId             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee   Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  diamond    Diamond?     @relation(fields: [diamondId], references: [id], onDelete: SetNull)
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  commission Commission?

  @@index([saleDate, productType, paymentStatus, orderStatus])
  @@index([employeeId, customerId])
}

model Commission {
  id               String       @id @default(uuid())
  saleId           String       @unique
  employeeId       String
  commissionBasis  String       @default("NET_PROFIT")
  commissionRate   Float        @default(0)
  commissionAmount Float        @default(0)
  status           String       @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  approvedBy       String?
  approvedAt       DateTime?
  paidBy           String?
  paidAt           DateTime?
  paymentReference String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sale             InternalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model SalesTarget {
  id            String    @id @default(uuid())
  employeeId    String
  periodType    String    @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  periodYear    Int
  periodMonth   Int?
  periodQuarter Int?
  targetAmount  Float     @default(0)
  startDate     DateTime
  endDate       DateTime
  status        String    @default("ACTIVE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, periodYear, periodType])
}


