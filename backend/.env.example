# Hostinger / Production Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.floksyjewel.com

# Database Connection (Hostinger MySQL / MariaDB)
# You can use individual variables OR the full DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_db_name
DB_USER=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password
DATABASE_URL="mysql://your_hostinger_db_user:your_hostinger_db_password@localhost:3306/your_hostinger_db_name"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_key

# PayPal Payment Gateway (Live Credentials)
PAYPAL_CLIENT_ID=your_paypal_live_client_id
PAYPAL_CLIENT_SECRET=your_paypal_live_client_secret
PAYPAL_MODE=live

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
